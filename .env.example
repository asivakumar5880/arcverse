# ArcVerse Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcverse_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ─── Admin Account ─────────────────────────────────────────────────────────────
# The email address for the site administrator account
ADMIN_EMAIL=admin@example.com

# Bcrypt hash of the admin password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens (use a long random string, min 32 chars)
JWT_SECRET=your_secure_random_jwt_secret_here

# Token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d
